# Supabase — Créer un projet sur https://supabase.com
# Puis copier URL + anon key depuis Settings > API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Anthropic — Clé API pour les fonctionnalités IA (chatbot, suggestions, etc.)
VITE_ANTHROPIC_API_KEY=your-anthropic-api-key-here

# ════════════════════════════════════════════════════════════════════════════
# AUTO-POSTEUR — serveur uniquement, JAMAIS de préfixe VITE_
# ════════════════════════════════════════════════════════════════════════════
# Tant que META_PAGE_ACCESS_TOKEN est vide, l'auto-posteur tourne en SIMULATION
# et ne fait aucun appel réseau. C'est le comportement voulu aujourd'hui.
#
# Il faut QUATRE verrous ouverts en même temps pour qu'une publication réelle
# parte, et aucun ne suffit seul :
#   1. le jeton ci-dessous ;
#   2. la ligne autopost_controle en actif=true et mode='live' (verrou
#      d'exploitation, basculable en 10 s sans redéploiement) ;
#   3. AUTOPOST_MODE=live ci-dessous (cran de sûreté de déploiement) ;
#   4. mode_execution "live" sur la publication elle-même.
META_PAGE_ACCESS_TOKEN=
AUTOPOST_MODE=dry_run
AUTOPOST_CLE_APPROBATION=
# Authentifie les tâches planifiées Vercel sur /api/autopost-tick.
# Vide = toute tâche planifiée est refusée (voulu : pas d'URL publique qui publie).
CRON_SECRET=

# Lecture du Drive — compte de service Google, en LECTURE SEULE, sur le seul
# dossier 10_PUBLICATIONS/. Procédure complète en tête de api/autopost.js.
# Vides aujourd'hui : le dépôt des publications se fait depuis l'application.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
DRIVE_DOSSIER_PUBLICATIONS_ID=

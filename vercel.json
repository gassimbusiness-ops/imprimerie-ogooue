      "destination": "/conditions.html"
    },
    {
      "source": "/suppression-donnees.html",
      "destination": "/suppression-donnees.html"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/autopost?voie=tick&h=08",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/autopost?voie=tick&h=17",
      "schedule": "0 17 * * *"
    }
  ]

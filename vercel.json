    },
    {
      "source": "/api/chatgpt-depense",
      "destination": "/api/chatgpt?voie=depense"
    },
    {
      "source": "/api/chatgpt-recette",
      "destination": "/api/chatgpt?voie=recette"
    },
    {
      "source": "/api/chatgpt-caisse-mouvement",

{
  "functions": {
    "api/chatgpt.js": {
      "includeFiles": "api/_lib/chatgpt-openapi.json"
    }
  },
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/registerSW.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/singpay-initiate",
      "destination": "/api/singpay?voie=initiate"
    },
    {
      "source": "/api/singpay-status",
      "destination": "/api/singpay?voie=status"
    },
    {
      "source": "/api/singpay-callback",
      "destination": "/api/singpay?voie=callback"
    },
    {
      "source": "/api/zakat-analyse",
      "destination": "/api/ai?voie=zakat"
    },
    {
      "source": "/api/autopost-tick",
      "destination": "/api/autopost?voie=tick"
    },
    {
      "source": "/api/autopost-etat",
      "destination": "/api/autopost?voie=etat"
    },
    {
      "source": "/api/chatgpt-inventaire",
      "destination": "/api/chatgpt?voie=inventaire"
    },
    {
      "source": "/api/chatgpt-collection",
      "destination": "/api/chatgpt?voie=collection"
    },
